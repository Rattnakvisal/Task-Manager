{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 60
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/images/$1"
        },
        {
            "src": "/(favicon\\.ico|robots\\.txt)",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_KEY": "base64:j9iVYCs3sOXC5AOV536lkVyKDlDLN1WqnTkQBcZC5nA=",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "CACHE_STORE": "array",
        "LOG_CHANNEL": "stderr",
        "QUEUE_CONNECTION": "sync",
        "DB_CONNECTION": "pgsql",
        "DB_HOST": "aws-0-ap-southeast-2.pooler.supabase.com",
        "DB_PORT": "5432",
        "DB_DATABASE": "task_manager",
        "DB_USERNAME": "postgres.pdtyrvnhxalbqagzjrhb",
        "DB_PASSWORD": "Wq_76wZtR2aPRmq",
        "DB_SSLMODE": "require",
        "DATABASE_URL": "postgresql://postgres.pdtyrvnhxalbqagzjrhb:Wq_76wZtR2aPRmq@aws-0-ap-southeast-2.pooler.supabase.com:5432/task_manager?sslmode=require",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "true",
        "VERCEL_RUNTIME_MIGRATE": "true"
    }
}

