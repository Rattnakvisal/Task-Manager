{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 30
        }
    },
    "regions": ["sin1"],
    "routes": [
        { "src": "/build/(.*)", "dest": "/build/$1" },
        { "src": "/robots.txt", "dest": "/robots.txt" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
